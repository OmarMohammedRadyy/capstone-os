# Capstone OS — environment variables (names + safe local defaults only; never commit real secrets)
# Copy to `.env` and fill in values. Validated at boot by src/server/config/env.ts (fails fast).

NODE_ENV=development

# PostgreSQL 18 connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/capstone_os
# Used only by integration tests (separate, disposable database)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/capstone_os_test

# Public base URL of the app (used for links in emails, invite URLs, CSRF origin checks)
APP_URL=http://localhost:3000

# >= 32 random characters. Used for HMAC of IP hashes and token derivation.
SESSION_SECRET=

# Object storage: "local" (filesystem, dev) or "s3" (any S3-compatible service, e.g. MinIO, AWS S3, R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Max upload size in megabytes
UPLOAD_MAX_MB=25

# Email: "log" (writes to server log, dev) or "smtp"
EMAIL_PROVIDER=log
EMAIL_FROM="Capstone OS <no-reply@example.edu>"
EMAIL_PROVIDER_SMTP_HOST=
EMAIL_PROVIDER_SMTP_PORT=587
EMAIL_PROVIDER_SMTP_USER=
EMAIL_PROVIDER_SMTP_PASSWORD=

# Background jobs: run the job worker inside the web process (true for single-node deployments)
JOBS_INLINE_WORKER=true

# Allow self-service registration
REGISTRATION_OPEN=true

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Optional integrations
REDIS_URL=
ERROR_TRACKING_DSN=

