// Capstone OS — PostgreSQL schema (docs/08_DATABASE_DESIGN.md, docs/09_ERD.md, docs/42_DATA_DICTIONARY_AND_ENUMS.md)
// Conventions: UUID PKs, timestamptz (Prisma DateTime -> timestamp(3) with time zone via @db.Timestamptz),
// snake_case table/column names, project_id on every project-scoped table, explicit FKs over polymorphic refs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum SystemRole {
  USER
  DEPARTMENT_ADMIN
  SYSTEM_ADMIN
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  AT_RISK
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  STUDENT
  TEAM_LEADER
  SUPERVISOR
  DEPARTMENT_ADMIN
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum SprintScopeChangeType {
  ADDED
  REMOVED
  CARRIED_IN
  CARRIED_OUT
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PhaseProgressStrategy {
  MILESTONES
  TASKS
}

enum MilestoneStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  BLOCKED
  AWAITING_APPROVAL
  COMPLETED
}

enum MilestoneApprovalAction {
  REQUESTED
  APPROVED
  CHANGES_REQUESTED
  REOPENED
}

enum MeetingType {
  TEAM
  SUPERVISOR
  DEPARTMENT
  REHEARSAL
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  ARCHIVED
}

enum AttendanceStatus {
  INVITED
  PRESENT
  ABSENT
  EXCUSED
}

enum ActionItemStatus {
  OPEN
  DONE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  AWAITING_VERIFICATION
  VERIFIED
}

enum FeedbackSeverity {
  NOTE
  IMPORTANT
  BLOCKING
}

enum FeedbackCategory {
  REQUIREMENTS
  UI_UX
  TECHNICAL
  DOCUMENTATION
  RESEARCH
  PRESENTATION
  SCOPE
  OTHER
}

enum FeedbackTargetType {
  PROJECT
  MILESTONE
  TASK
  DOCUMENT
  SUBMISSION
  SCREEN
}

enum DocumentCategory {
  PROPOSAL
  SRS
  RESEARCH
  UI_UX
  ARCHITECTURE
  DATABASE
  TESTING
  REPORT
  PRESENTATION
  DEMO_ASSET
  ADMINISTRATIVE
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum ScanStatus {
  PENDING
  CLEAN
  SKIPPED
  INFECTED
}

enum DecisionStatus {
  PROPOSED
  ACCEPTED
  SUPERSEDED
  REJECTED
}

enum RiskStatus {
  OPEN
  MITIGATING
  MONITORING
  CLOSED
  MATERIALIZED
}

enum RiskCategory {
  TECHNICAL
  SCHEDULE
  SCOPE
  TEAM
  EXTERNAL
  QUALITY
  OTHER
}

enum IssueStatus {
  OPEN
  INVESTIGATING
  FIXING
  MONITORING
  RESOLVED
  CLOSED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SubmissionStatus {
  DRAFT
  PREPARING
  READY
  FROZEN
  SUBMITTED
  ACCEPTED
  CHANGES_REQUESTED
}

enum RequirementType {
  CHECKLIST
  DOCUMENT
  URL
  DECLARATION
  REVIEWER_APPROVAL
}

enum SubmissionEventType {
  CREATED
  FROZEN
  UNFROZEN
  SUBMITTED
  ACCEPTED
  CHANGES_REQUESTED
}

enum DefenseSectionStatus {
  NOT_STARTED
  DRAFTING
  READY
}

enum DefenseChecklistCategory {
  MATERIALS
  DEMO
  EQUIPMENT
  SCRIPT
  REHEARSAL
}

enum DefenseQuestionStatus {
  DRAFT
  PREPARED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationCategory {
  ASSIGNMENT
  MENTION
  DEADLINE
  FEEDBACK
  MILESTONE
  SUBMISSION
  DOCUMENT
  INVITE
  SYSTEM
}

enum EmailFrequency {
  INSTANT
  DAILY_DIGEST
  OFF
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique @db.VarChar(254)
  name            String          @db.VarChar(120)
  passwordHash    String          @map("password_hash")
  systemRole      SystemRole      @default(USER) @map("system_role")
  locale          String          @default("en") @db.VarChar(10)
  theme           ThemePreference @default(SYSTEM)
  timezone        String          @default("Africa/Cairo") @db.VarChar(64)
  emailVerifiedAt DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  isActive        Boolean         @default(true) @map("is_active")
  lastProjectId   String?         @map("last_project_id") @db.Uuid
  failedLogins    Int             @default(0) @map("failed_logins")
  lockedUntil     DateTime?       @map("locked_until") @db.Timestamptz(3)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  passwordResets          PasswordResetToken[]
  memberships             ProjectMember[]
  supervisedProjects      Project[]                @relation("ProjectSupervisor")
  createdProjects         Project[]                @relation("ProjectCreator")
  invitesCreated          ProjectInvite[]          @relation("InviteCreator")
  taskAssignments         TaskAssignee[]
  tasksCreated            Task[]                   @relation("TaskCreator")
  tasksReviewed           Task[]                   @relation("TaskReviewer")
  taskComments            TaskComment[]
  commentMentions         TaskCommentMention[]
  checklistDone           TaskChecklistItem[]
  milestonesOwned         Milestone[]              @relation("MilestoneOwner")
  milestoneApprovals      MilestoneApproval[]
  milestoneEvidence       MilestoneEvidence[]
  meetingsCreated         Meeting[]
  meetingAttendance       MeetingAttendee[]
  meetingActions          MeetingAction[]
  feedbackAuthored        Feedback[]               @relation("FeedbackAuthor")
  feedbackAssigned        Feedback[]               @relation("FeedbackAssignee")
  feedbackVerified        Feedback[]               @relation("FeedbackVerifier")
  feedbackEvents          FeedbackEvent[]
  documentsOwned          Document[]
  documentVersions        DocumentVersion[]
  decisionsOwned          Decision[]
  decisionRevisions       DecisionRevision[]
  risksOwned              Risk[]
  issuesOwned             Issue[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  submissionsOwned        Submission[]             @relation("SubmissionOwner")
  submissionsFrozen       Submission[]             @relation("SubmissionFreezer")
  requirementsCompleted   SubmissionRequirement[]
  submissionSnapshots     SubmissionSnapshot[]
  submissionEvents        SubmissionEvent[]
  defenseSections         DefenseSection[]
  defenseChecklist        DefenseChecklistItem[]
  defenseQuestions        DefenseQuestion[]
  defenseAssets           DefenseAsset[]
  activity                ActivityEvent[]
  auditLogs               AuditLog[]
  sprintScopeChanges      SprintScopeChange[]
  labelsCreated           Label[]
  taskAttachments         TaskAttachment[]
  settingsUpdated         SystemSetting[]

  @@index([systemRole])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Projects & Team ─────────────────────────────

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique @db.VarChar(80)
  title            String        @db.VarChar(200)
  code             String        @db.VarChar(30)
  abstract         String?       @db.VarChar(20000)
  academicYear     String        @map("academic_year") @db.VarChar(20)
  department       String        @db.VarChar(120)
  status           ProjectStatus @default(PLANNING)
  startDate        DateTime      @map("start_date") @db.Date
  endDate          DateTime      @map("end_date") @db.Date
  timezone         String        @default("Africa/Cairo") @db.VarChar(64)
  locale           String        @default("en") @db.VarChar(10)
  supervisorId     String?       @map("supervisor_user_id") @db.Uuid
  createdById      String        @map("created_by") @db.Uuid
  taskSequence     Int           @default(0) @map("task_sequence")
  decisionSequence Int           @default(0) @map("decision_sequence")
  // Health weights (docs/18): configurable per project, CHECK constraint enforces sum = 100.
  weightSchedule   Int           @default(30) @map("weight_schedule")
  weightTasks      Int           @default(20) @map("weight_tasks")
  weightFeedback   Int           @default(15) @map("weight_feedback")
  weightRisk       Int           @default(15) @map("weight_risk")
  weightReadiness  Int           @default(10) @map("weight_readiness")
  weightWorkload   Int           @default(10) @map("weight_workload")
  statusBeforeArchive ProjectStatus? @map("status_before_archive")
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(3)
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  supervisor            User?                 @relation("ProjectSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  createdBy             User                  @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members               ProjectMember[]
  invites               ProjectInvite[]
  phases                Phase[]
  milestones            Milestone[]
  sprints               Sprint[]
  tasks                 Task[]
  labels                Label[]
  meetings              Meeting[]
  feedback              Feedback[]
  documents             Document[]
  decisions             Decision[]
  risks                 Risk[]
  issues                Issue[]
  healthSnapshots       HealthSnapshot[]
  contributionSnapshots ContributionSnapshot[]
  notifications         Notification[]
  submissions           Submission[]
  defensePlan           DefensePlan?
  activity              ActivityEvent[]
  auditLogs             AuditLog[]

  @@index([status])
  @@index([academicYear])
  @@index([supervisorId])
  @@map("projects")
}

model ProjectMember {
  id                  String      @id @default(uuid()) @db.Uuid
  projectId           String      @map("project_id") @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  role                ProjectRole
  responsibilityTitle String?     @map("responsibility_title") @db.VarChar(60)
  capacityPoints      Int?        @map("capacity_points")
  active              Boolean     @default(true)
  joinedAt            DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt              DateTime?   @map("left_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId, active])
  @@map("project_members")
}

model ProjectInvite {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  email       String?     @db.VarChar(254)
  role        ProjectRole
  tokenHash   String      @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  maxUses     Int         @default(1) @map("max_uses")
  useCount    Int         @default(0) @map("use_count")
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdById String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_invites")
}

// ───────────────────────────── Roadmap ─────────────────────────────

model Phase {
  id               String                @id @default(uuid()) @db.Uuid
  projectId        String                @map("project_id") @db.Uuid
  name             String                @db.VarChar(200)
  description      String?               @db.VarChar(20000)
  order            Int
  startDate        DateTime?             @map("start_date") @db.Date
  endDate          DateTime?             @map("end_date") @db.Date
  status           PhaseStatus           @default(NOT_STARTED)
  progressStrategy PhaseProgressStrategy @default(MILESTONES) @map("progress_strategy")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([projectId, order])
  @@map("phases")
}

model Milestone {
  id                 String          @id @default(uuid()) @db.Uuid
  projectId          String          @map("project_id") @db.Uuid
  phaseId            String?         @map("phase_id") @db.Uuid
  title              String          @db.VarChar(200)
  objective          String?         @db.VarChar(20000)
  acceptanceCriteria String?         @map("acceptance_criteria") @db.VarChar(20000)
  ownerId            String?         @map("owner_id") @db.Uuid
  dueDate            DateTime        @map("due_date") @db.Date
  status             MilestoneStatus @default(NOT_STARTED)
  requiresApproval   Boolean         @default(true) @map("requires_approval")
  order              Int             @default(0)
  approvedAt         DateTime?       @map("approved_at") @db.Timestamptz(3)
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(3)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     Phase?              @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  owner     User?               @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks     Task[]
  approvals MilestoneApproval[]
  evidence  MilestoneEvidence[]
  feedback  Feedback[]

  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([phaseId])
  @@map("milestones")
}

model MilestoneApproval {
  id          String                  @id @default(uuid()) @db.Uuid
  milestoneId String                  @map("milestone_id") @db.Uuid
  action      MilestoneApprovalAction
  actorId     String                  @map("actor_id") @db.Uuid
  comment     String?                 @db.VarChar(10000)
  feedbackId  String?                 @unique @map("feedback_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  feedback  Feedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([milestoneId, createdAt])
  @@map("milestone_approvals")
}

model MilestoneEvidence {
  id                String   @id @default(uuid()) @db.Uuid
  milestoneId       String   @map("milestone_id") @db.Uuid
  documentVersionId String?  @map("document_version_id") @db.Uuid
  url               String?  @db.VarChar(2000)
  note              String?  @db.VarChar(2000)
  addedById         String   @map("added_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  milestone       Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  addedBy         User             @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@index([milestoneId])
  @@map("milestone_evidence")
}

// ───────────────────────────── Sprints & Tasks ─────────────────────────────

model Sprint {
  id                 String       @id @default(uuid()) @db.Uuid
  projectId          String       @map("project_id") @db.Uuid
  name               String       @db.VarChar(200)
  goal               String?      @db.VarChar(2000)
  startDate          DateTime     @map("start_date") @db.Date
  endDate            DateTime     @map("end_date") @db.Date
  status             SprintStatus @default(PLANNED)
  plannedCapacity    Int?         @map("planned_capacity")
  riskNotes          String?      @map("risk_notes") @db.VarChar(5000)
  baselinePoints     Int?         @map("baseline_points")
  baselineTaskCount  Int?         @map("baseline_task_count")
  completedPoints    Int?         @map("completed_points")
  completedTaskCount Int?         @map("completed_task_count")
  carriedOverCount   Int?         @map("carried_over_count")
  retrospective      String?      @db.VarChar(20000)
  startedAt          DateTime?    @map("started_at") @db.Timestamptz(3)
  closedAt           DateTime?    @map("closed_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  scopeChanges SprintScopeChange[]

  @@index([projectId, status])
  @@map("sprints")
}

model SprintScopeChange {
  id          String                @id @default(uuid()) @db.Uuid
  sprintId    String                @map("sprint_id") @db.Uuid
  taskId      String                @map("task_id") @db.Uuid
  type        SprintScopeChangeType
  afterStart  Boolean               @map("after_start")
  points      Int?
  actorId     String                @map("actor_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([sprintId, createdAt])
  @@index([taskId])
  @@map("sprint_scope_changes")
}

model Task {
  id                 String     @id @default(uuid()) @db.Uuid
  projectId          String     @map("project_id") @db.Uuid
  number             Int
  sprintId           String?    @map("sprint_id") @db.Uuid
  milestoneId        String?    @map("milestone_id") @db.Uuid
  parentTaskId       String?    @map("parent_task_id") @db.Uuid
  title              String     @db.VarChar(200)
  description        String?    @db.VarChar(20000)
  acceptanceCriteria String?    @map("acceptance_criteria") @db.VarChar(20000)
  status             TaskStatus @default(BACKLOG)
  statusBeforeBlock  TaskStatus? @map("status_before_block")
  priority           Priority   @default(MEDIUM)
  estimatePoints     Int?       @map("estimate_points")
  dueAt              DateTime?  @map("due_at") @db.Timestamptz(3)
  blockedReason      String?    @map("blocked_reason") @db.VarChar(2000)
  createdById        String     @map("created_by") @db.Uuid
  reviewedById       String?    @map("reviewed_by") @db.Uuid
  sourceActionId     String?    @unique @map("source_action_id") @db.Uuid
  startedAt          DateTime?  @map("started_at") @db.Timestamptz(3)
  inReviewAt         DateTime?  @map("in_review_at") @db.Timestamptz(3)
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz(3)
  firstCompletedAt   DateTime?  @map("first_completed_at") @db.Timestamptz(3)
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone    Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent       Task?                @relation("TaskParent", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children     Task[]               @relation("TaskParent")
  createdBy    User                 @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy   User?                @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  sourceAction MeetingAction?       @relation("ActionTask", fields: [sourceActionId], references: [id], onDelete: SetNull)
  assignees    TaskAssignee[]
  blockedBy    TaskDependency[]     @relation("DependentTask")
  blocks       TaskDependency[]     @relation("BlockingTask")
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  labels       TaskLabel[]
  attachments  TaskAttachment[]
  feedback     Feedback[]
  scopeChanges SprintScopeChange[]
  issues       IssueTask[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, dueAt])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([sprintId])
  @@index([milestoneId])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskDependency {
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskChecklistItem {
  id       String    @id @default(uuid()) @db.Uuid
  taskId   String    @map("task_id") @db.Uuid
  text     String    @db.VarChar(500)
  done     Boolean   @default(false)
  order    Int       @default(0)
  doneAt   DateTime? @map("done_at") @db.Timestamptz(3)
  doneById String?   @map("done_by") @db.Uuid

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneBy User? @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@index([taskId, order])
  @@map("task_checklist_items")
}

model TaskComment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String    @db.VarChar(10000)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task     Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mentions TaskCommentMention[]

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskCommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([commentId, userId])
  @@map("task_comment_mentions")
}

model Label {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String   @db.VarChar(60)
  color       String   @default("slate") @db.VarChar(20)
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks     TaskLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model TaskAttachment {
  id                String   @id @default(uuid()) @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  documentVersionId String   @map("document_version_id") @db.Uuid
  addedById         String   @map("added_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task            Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  addedBy         User            @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([taskId, documentVersionId])
  @@map("task_attachments")
}

// ───────────────────────────── Meetings ─────────────────────────────

model Meeting {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  type            MeetingType
  title           String        @db.VarChar(200)
  scheduledAt     DateTime      @map("scheduled_at") @db.Timestamptz(3)
  durationMinutes Int           @default(60) @map("duration_minutes")
  location        String?       @db.VarChar(500)
  agenda          String?       @db.VarChar(50000)
  notes           String?       @db.VarChar(50000)
  summary         String?       @db.VarChar(5000)
  openQuestions   String?       @map("open_questions") @db.VarChar(20000)
  status          MeetingStatus @default(SCHEDULED)
  createdById     String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attendees MeetingAttendee[]
  actions   MeetingAction[]
  decisions Decision[]

  @@index([projectId, scheduledAt])
  @@index([projectId, status])
  @@map("meetings")
}

model MeetingAttendee {
  meetingId  String           @map("meeting_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  attendance AttendanceStatus @default(INVITED)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_attendees")
}

model MeetingAction {
  id          String           @id @default(uuid()) @db.Uuid
  meetingId   String           @map("meeting_id") @db.Uuid
  text        String           @db.VarChar(1000)
  ownerId     String?          @map("owner_id") @db.Uuid
  dueDate     DateTime?        @map("due_date") @db.Date
  status      ActionItemStatus @default(OPEN)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  task    Task?   @relation("ActionTask")

  @@index([meetingId])
  @@index([ownerId, status])
  @@map("meeting_actions")
}

// ───────────────────────────── Supervisor Feedback ─────────────────────────────

model Feedback {
  id                        String             @id @default(uuid()) @db.Uuid
  projectId                 String             @map("project_id") @db.Uuid
  authorId                  String             @map("author_id") @db.Uuid
  assigneeId                String?            @map("assignee_id") @db.Uuid
  targetType                FeedbackTargetType @map("target_type")
  milestoneId               String?            @map("milestone_id") @db.Uuid
  taskId                    String?            @map("task_id") @db.Uuid
  documentId                String?            @map("document_id") @db.Uuid
  documentVersionId         String?            @map("document_version_id") @db.Uuid
  submissionId              String?            @map("submission_id") @db.Uuid
  screenRef                 String?            @map("screen_ref") @db.VarChar(200)
  category                  FeedbackCategory
  severity                  FeedbackSeverity
  title                     String             @db.VarChar(200)
  body                      String             @db.VarChar(20000)
  status                    FeedbackStatus     @default(OPEN)
  dueDate                   DateTime?          @map("due_date") @db.Date
  resolutionNote            String?            @map("resolution_note") @db.VarChar(10000)
  evidenceDocumentVersionId String?            @map("evidence_document_version_id") @db.Uuid
  evidenceUrl               String?            @map("evidence_url") @db.VarChar(2000)
  resolvedAt                DateTime?          @map("resolved_at") @db.Timestamptz(3)
  verifiedAt                DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedById              String?            @map("verified_by") @db.Uuid
  reopenCount               Int                @default(0) @map("reopen_count")
  version                   Int                @default(1)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author           User               @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignee         User?              @relation("FeedbackAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  verifiedBy       User?              @relation("FeedbackVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  milestone        Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  task             Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  document         Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentVersion  DocumentVersion?   @relation("FeedbackTargetVersion", fields: [documentVersionId], references: [id], onDelete: SetNull)
  evidenceVersion  DocumentVersion?   @relation("FeedbackEvidenceVersion", fields: [evidenceDocumentVersionId], references: [id], onDelete: SetNull)
  submission       Submission?        @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  events           FeedbackEvent[]
  milestoneRequest MilestoneApproval?

  @@index([projectId, status])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([assigneeId, status])
  @@index([milestoneId])
  @@index([documentId])
  @@map("feedback")
}

model FeedbackEvent {
  id         String          @id @default(uuid()) @db.Uuid
  feedbackId String          @map("feedback_id") @db.Uuid
  fromStatus FeedbackStatus? @map("from_status")
  toStatus   FeedbackStatus  @map("to_status")
  actorId    String          @map("actor_id") @db.Uuid
  note       String?         @db.VarChar(10000)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([feedbackId, createdAt])
  @@map("feedback_events")
}

// ───────────────────────────── Documents ─────────────────────────────

model Document {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  title            String           @db.VarChar(200)
  description      String?          @db.VarChar(20000)
  category         DocumentCategory
  tags             String[]         @default([])
  status           DocumentStatus   @default(DRAFT)
  ownerId          String?          @map("owner_id") @db.Uuid
  isOfficial       Boolean          @default(false) @map("is_official")
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  versionSequence  Int              @default(0) @map("version_sequence")
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner          User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  currentVersion DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[] @relation("DocumentVersions")
  feedback       Feedback[]

  @@index([projectId, category])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("documents")
}

model DocumentVersion {
  id             String     @id @default(uuid()) @db.Uuid
  documentId     String     @map("document_id") @db.Uuid
  versionNumber  Int        @map("version_number")
  storageKey     String     @unique @map("storage_key") @db.VarChar(300)
  originalName   String     @map("original_name") @db.VarChar(255)
  mimeType       String     @map("mime_type") @db.VarChar(120)
  byteSize       Int        @map("byte_size")
  checksumSha256 String     @map("checksum_sha256") @db.Char(64)
  note           String?    @db.VarChar(2000)
  scanStatus     ScanStatus @default(PENDING) @map("scan_status")
  uploadedById   String     @map("uploaded_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  document            Document             @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  currentOf           Document?            @relation("CurrentVersion")
  uploadedBy          User                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  milestoneEvidence   MilestoneEvidence[]
  taskAttachments     TaskAttachment[]
  feedbackTargets     Feedback[]           @relation("FeedbackTargetVersion")
  feedbackEvidence    Feedback[]           @relation("FeedbackEvidenceVersion")
  requirementLinks    SubmissionRequirement[]
  submissionArtifacts SubmissionArtifact[]
  defenseAssets       DefenseAsset[]

  @@unique([documentId, versionNumber])
  @@index([uploadedById])
  @@map("document_versions")
}

// ───────────────────────────── Decisions / Risks / Issues ─────────────────────────────

model Decision {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  number          Int
  title           String         @db.VarChar(200)
  context         String         @db.VarChar(20000)
  chosenOption    String?        @map("chosen_option") @db.VarChar(2000)
  rationale       String?        @db.VarChar(20000)
  consequences    String?        @db.VarChar(20000)
  status          DecisionStatus @default(PROPOSED)
  ownerId         String?        @map("owner_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Date
  meetingId       String?        @map("meeting_id") @db.Uuid
  supersededById  String?        @unique @map("superseded_by_id") @db.Uuid
  impactedModules String[]       @default([]) @map("impacted_modules")
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  meeting      Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  supersededBy Decision?          @relation("Supersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Decision?          @relation("Supersession")
  options      DecisionOption[]
  revisions    DecisionRevision[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("decisions")
}

model DecisionOption {
  id         String  @id @default(uuid()) @db.Uuid
  decisionId String  @map("decision_id") @db.Uuid
  title      String  @db.VarChar(200)
  pros       String? @db.VarChar(5000)
  cons       String? @db.VarChar(5000)
  order      Int     @default(0)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, order])
  @@map("decision_options")
}

/// Immutable edit history. Snapshot is a frozen copy of the record at the time of the edit (append-only).
model DecisionRevision {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  revision   Int
  snapshot   Json
  editorId   String   @map("editor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  editor   User     @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([decisionId, revision])
  @@map("decision_revisions")
}

model Risk {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.VarChar(20000)
  category    RiskCategory @default(OTHER)
  probability Int
  impact      Int
  ownerId     String?      @map("owner_id") @db.Uuid
  mitigation  String?      @db.VarChar(10000)
  contingency String?      @db.VarChar(10000)
  trigger     String?      @db.VarChar(2000)
  status      RiskStatus   @default(OPEN)
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz(3)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  issues  Issue[]

  @@index([projectId, status])
  @@map("risks")
}

model Issue {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  title       String        @db.VarChar(200)
  description String?       @db.VarChar(20000)
  severity    IssueSeverity
  status      IssueStatus   @default(OPEN)
  isBlocker   Boolean       @default(false) @map("is_blocker")
  ownerId     String?       @map("owner_id") @db.Uuid
  riskId      String?       @map("risk_id") @db.Uuid
  detectedAt  DateTime      @default(now()) @map("detected_at") @db.Timestamptz(3)
  rootCause   String?       @map("root_cause") @db.VarChar(10000)
  resolution  String?       @db.VarChar(10000)
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(3)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  risk    Risk?       @relation(fields: [riskId], references: [id], onDelete: SetNull)
  tasks   IssueTask[]

  @@index([projectId, status])
  @@map("issues")
}

model IssueTask {
  issueId String @map("issue_id") @db.Uuid
  taskId  String @map("task_id") @db.Uuid

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([issueId, taskId])
  @@index([taskId])
  @@map("issue_tasks")
}

// ───────────────────────────── Intelligence ─────────────────────────────

/// Immutable historical snapshot (never rewritten). drivers holds the explainability payload.
model HealthSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  score           Int
  status          String   @db.VarChar(30)
  confidence      Int
  scheduleScore   Int?     @map("schedule_score")
  tasksScore      Int?     @map("tasks_score")
  feedbackScore   Int?     @map("feedback_score")
  riskScore       Int?     @map("risk_score")
  readinessScore  Int?     @map("readiness_score")
  workloadScore   Int?     @map("workload_score")
  drivers         Json
  trigger         String   @db.VarChar(60)
  calculatedAt    DateTime @default(now()) @map("calculated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, calculatedAt(sort: Desc)])
  @@map("health_snapshots")
}

model ContributionSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  periodStart      DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd        DateTime @map("period_end") @db.Timestamptz(3)
  completedTasks   Int      @map("completed_tasks")
  points           Int
  reviews          Int
  docsVersions     Int      @map("docs_versions")
  decisionsOwned   Int      @map("decisions_owned")
  feedbackResolved Int      @map("feedback_resolved")
  actionsCompleted Int      @map("actions_completed")
  milestonesOwned  Int      @map("milestones_owned")
  ownershipWeight  Int      @map("ownership_weight")
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, computedAt(sort: Desc)])
  @@index([projectId, userId])
  @@map("contribution_snapshots")
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  projectId  String?              @map("project_id") @db.Uuid
  category   NotificationCategory
  type       String               @db.VarChar(60)
  params     Json
  href       String?              @db.VarChar(500)
  readAt     DateTime?            @map("read_at") @db.Timestamptz(3)
  archivedAt DateTime?            @map("archived_at") @db.Timestamptz(3)
  emailedAt  DateTime?            @map("emailed_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, archivedAt, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  inApp     Boolean              @default(true) @map("in_app")
  email     EmailFrequency       @default(INSTANT)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

// ───────────────────────────── Submissions ─────────────────────────────

model Submission {
  id                         String           @id @default(uuid()) @db.Uuid
  projectId                  String           @map("project_id") @db.Uuid
  title                      String           @db.VarChar(200)
  description                String?          @db.VarChar(20000)
  deadline                   DateTime         @db.Timestamptz(3)
  ownerId                    String?          @map("owner_id") @db.Uuid
  status                     SubmissionStatus @default(DRAFT)
  requiresSupervisorApproval Boolean          @default(true) @map("requires_supervisor_approval")
  frozenAt                   DateTime?        @map("frozen_at") @db.Timestamptz(3)
  frozenById                 String?          @map("frozen_by") @db.Uuid
  submittedAt                DateTime?        @map("submitted_at") @db.Timestamptz(3)
  decidedAt                  DateTime?        @map("decided_at") @db.Timestamptz(3)
  decisionNote               String?          @map("decision_note") @db.VarChar(10000)
  version                    Int              @default(1)
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?                   @relation("SubmissionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  frozenBy     User?                   @relation("SubmissionFreezer", fields: [frozenById], references: [id], onDelete: SetNull)
  requirements SubmissionRequirement[]
  snapshots    SubmissionSnapshot[]
  artifacts    SubmissionArtifact[]
  events       SubmissionEvent[]
  feedback     Feedback[]

  @@index([projectId, status])
  @@index([projectId, deadline])
  @@map("submissions")
}

model SubmissionRequirement {
  id                String           @id @default(uuid()) @db.Uuid
  submissionId      String           @map("submission_id") @db.Uuid
  type              RequirementType
  title             String           @db.VarChar(200)
  description       String?          @db.VarChar(2000)
  required          Boolean          @default(true)
  documentCategory  DocumentCategory? @map("document_category")
  documentVersionId String?          @map("document_version_id") @db.Uuid
  url               String?          @db.VarChar(2000)
  completed         Boolean          @default(false)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(3)
  completedById     String?          @map("completed_by") @db.Uuid
  order             Int              @default(0)

  submission      Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion?     @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  completedBy     User?                @relation(fields: [completedById], references: [id], onDelete: SetNull)
  artifacts       SubmissionArtifact[]

  @@index([submissionId, order])
  @@map("submission_requirements")
}

/// Immutable freeze snapshot metadata (one per freeze). Artifacts reference exact document versions.
model SubmissionSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  sequence     Int
  readiness    Int
  createdById  String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)

  submission Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  artifacts  SubmissionArtifact[]

  @@unique([submissionId, sequence])
  @@map("submission_snapshots")
}

model SubmissionArtifact {
  id                String   @id @default(uuid()) @db.Uuid
  snapshotId        String   @map("snapshot_id") @db.Uuid
  submissionId      String   @map("submission_id") @db.Uuid
  requirementId     String?  @map("requirement_id") @db.Uuid
  label             String   @db.VarChar(200)
  requirementType   RequirementType @map("requirement_type")
  documentVersionId String?  @map("document_version_id") @db.Uuid
  url               String?  @db.VarChar(2000)
  checksumSha256    String?  @map("checksum_sha256") @db.Char(64)
  completed         Boolean
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  snapshot        SubmissionSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  submission      Submission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requirement     SubmissionRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  documentVersion DocumentVersion?       @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@index([snapshotId])
  @@index([submissionId])
  @@map("submission_artifacts")
}

model SubmissionEvent {
  id           String              @id @default(uuid()) @db.Uuid
  submissionId String              @map("submission_id") @db.Uuid
  type         SubmissionEventType
  actorId      String              @map("actor_id") @db.Uuid
  note         String?             @db.VarChar(10000)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@map("submission_events")
}

// ───────────────────────────── Defense ─────────────────────────────

model DefensePlan {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @unique @map("project_id") @db.Uuid
  defenseAt         DateTime? @map("defense_at") @db.Timestamptz(3)
  location          String?   @db.VarChar(500)
  demoScript        String?   @map("demo_script") @db.VarChar(50000)
  backupPlan        String?   @map("backup_plan") @db.VarChar(20000)
  buildUrl          String?   @map("build_url") @db.VarChar(2000)
  assetsFrozenAt    DateTime? @map("assets_frozen_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections  DefenseSection[]
  checklist DefenseChecklistItem[]
  questions DefenseQuestion[]
  assets    DefenseAsset[]

  @@map("defense_plans")
}

model DefenseSection {
  id              String               @id @default(uuid()) @db.Uuid
  planId          String               @map("plan_id") @db.Uuid
  title           String               @db.VarChar(200)
  ownerId         String?              @map("owner_id") @db.Uuid
  durationMinutes Int                  @default(3) @map("duration_minutes")
  status          DefenseSectionStatus @default(NOT_STARTED)
  notes           String?              @db.VarChar(5000)
  order           Int                  @default(0)

  plan  DefensePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  owner User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([planId, order])
  @@map("defense_sections")
}

model DefenseChecklistItem {
  id       String                   @id @default(uuid()) @db.Uuid
  planId   String                   @map("plan_id") @db.Uuid
  category DefenseChecklistCategory
  title    String                   @db.VarChar(200)
  ownerId  String?                  @map("owner_id") @db.Uuid
  done     Boolean                  @default(false)
  doneAt   DateTime?                @map("done_at") @db.Timestamptz(3)
  order    Int                      @default(0)

  plan  DefensePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  owner User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([planId, order])
  @@map("defense_checklist_items")
}

model DefenseQuestion {
  id          String                @id @default(uuid()) @db.Uuid
  planId      String                @map("plan_id") @db.Uuid
  question    String                @db.VarChar(1000)
  answerNotes String?               @map("answer_notes") @db.VarChar(10000)
  ownerId     String?               @map("owner_id") @db.Uuid
  status      DefenseQuestionStatus @default(DRAFT)
  order       Int                   @default(0)

  plan  DefensePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  owner User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([planId, order])
  @@map("defense_questions")
}

model DefenseAsset {
  id                String  @id @default(uuid()) @db.Uuid
  planId            String  @map("plan_id") @db.Uuid
  label             String  @db.VarChar(200)
  documentVersionId String  @map("document_version_id") @db.Uuid
  ownerId           String? @map("owner_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan            DefensePlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  owner           User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@map("defense_assets")
}

// ───────────────────────────── Activity / Audit / Jobs / Settings ─────────────────────────────

/// Product history — append-only. Separate from audit logs by design (docs/20).
model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  type       String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  params     Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, entityType, entityId])
  @@index([projectId, actorId])
  @@map("activity_events")
}

/// Security/compliance history — append-only (UPDATE/DELETE blocked by trigger).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  projectId  String?  @map("project_id") @db.Uuid
  requestId  String?  @map("request_id") @db.VarChar(64)
  before     Json?
  after      Json?
  metadata   Json?
  ipHash     String?  @map("ip_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @db.VarChar(60)
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  runAfter       DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  errorSummary   String?   @map("error_summary") @db.VarChar(2000)
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(200)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, runAfter])
  @@map("jobs")
}

model IdempotencyKey {
  key         String   @id @db.VarChar(200)
  userId      String   @map("user_id") @db.Uuid
  scope       String   @db.VarChar(80)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("idempotency_keys")
}

model SystemSetting {
  key         String   @id @db.VarChar(80)
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

